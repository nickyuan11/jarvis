# 本地私密配置，不会提交到 Git。
# 第一次使用：把 application-local.yml.example 复制成 application-local.yml，再填上自己的值。
spring:
  datasource:
    # Docker 里的 MySQL 账号，密码和 .env 里的 MYSQL_PASSWORD 一致
    username: jarvis
    password: 在这里填jarvis账号的密码
  ai:
    openai:
      # 阿里云百炼的 API Key（用于向量化）
      api-key: 在这里填百炼的API Key
    deepseek:
      api-key: 在这里填你的DeepSeek API Key
  mail:
    # 发件邮箱，以及在邮箱设置里开启 SMTP 后生成的授权码（不是邮箱登录密码）
    username: 你的发件邮箱@163.com
    password: 在这里填SMTP授权码

jarvis:
  vector:
    datasource:
      # 和 .env 里的 POSTGRES_PASSWORD 一致
      password: 在这里填PostgreSQL的密码
  jwt:
    secret: 在这里填一段随机生成的Base64字符串
  pandascore:
    token: 在这里填你的PandaScore token
