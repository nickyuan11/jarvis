# 线上环境的配置模板。在服务器上：cp .env.prod.example .env，填好后执行 chmod 600 .env
# .env 不进 Git，也不会被打进镜像。密码建议只用字母和数字，避免特殊符号需要转义

# 域名（已经解析到这台服务器），例如 jarvis.example.com。Caddy 用它申请 HTTPS 证书
DOMAIN=

# 数据库密码：随便生成几个足够长的随机串，线上和本地不要用同一套
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
POSTGRES_PASSWORD=

# JWT 签名密钥：至少 32 字节的随机 Base64，生成命令：openssl rand -base64 48
JWT_SECRET=

# 注册邀请码：只有知道它的人才能注册
INVITE_CODE=

# DeepSeek（对话）和阿里云百炼（向量化）的 API Key
DEEPSEEK_API_KEY=
EMBEDDING_API_KEY=

# 可选：发提醒邮件的邮箱和 SMTP 授权码；英雄联盟赛事数据的 token
MAIL_USERNAME=
MAIL_PASSWORD=
PANDASCORE_TOKEN=
